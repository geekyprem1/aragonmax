# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (Moonshot direct OR OpenRouter) — server only
MOONSHOT_API_KEY=your-api-key
# Moonshot:   https://api.moonshot.ai/v1
# OpenRouter: https://openrouter.ai/api/v1
MOONSHOT_BASE_URL=https://openrouter.ai/api/v1

# Models (JSON array). key = real provider model id, name = what users see.
KIMI_MODELS=[{"key":"moonshotai/kimi-k2","name":"ArgonMax K3","badge":"Recommended"},{"key":"deepseek/deepseek-chat","name":"ArgonMax K3 Pro"}]
# Which model is used by default (must be one of the keys above)
KIMI_DEFAULT_MODEL=moonshotai/kimi-k2
# Vision-capable model for image analysis (Pro). Leave blank to disable vision.
KIMI_VISION_MODEL=openai/gpt-4o-mini

# Replicate (Creative Studio — image + video). Get token at replicate.com/account.
REPLICATE_API_TOKEN=your-replicate-token
REPLICATE_IMAGE_MODEL=openai/gpt-image-2
REPLICATE_VIDEO_MODEL=prunaai/p-video

# App
NEXT_PUBLIC_APP_NAME=ArgonMax AI
# Your deployed URL (optional, used for OpenRouter attribution headers)
NEXT_PUBLIC_APP_URL=https://your-app-url.com
